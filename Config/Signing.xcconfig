// Public signing defaults: ad-hoc, no Apple account required.
// Clone, run `xcodegen generate`, then build Debug and run the tests with no
// team or certificate. The maintainer's real Developer ID values live in
// Signing.local.xcconfig (gitignored, never published); the optional include
// below applies them when that file is present and otherwise is a no-op.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
